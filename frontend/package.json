{
  "name": "frontend",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "test:a11y": "playwright test",
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "generate:api": "npx --yes openapi-typescript@7 http://127.0.0.1:8000/openapi.json -o src/types/api.generated.ts && node scripts/snapshot-schema.mjs",
    "check:api": "node scripts/check-api-contract.mjs"
  },
  "dependencies": {
    "@xyflow/react": "^12.12.0",
    "dagre": "^0.8.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "playwright": "^1.45.0",
    "@axe-core/playwright": "^4.8.1",
    "@types/dagre": "^0.7.54",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "typescript": "^7.0.2",
    "vite": "^5.4.0"
  }
}
