# RouteLens Lite - Frontend environment variables
#
# Copy this file to .env.local and fill in values as needed.
# Never commit real secrets or credentials.

# URL of the separately hosted FastAPI backend.
#
# Read by the Vite dev server (frontend/vite.config.ts) to proxy API calls.
# Leave blank for local development: the Vite dev server proxies API calls
# to http://127.0.0.1:8000.
#
# For a backend on a different port or host, set this to the backend origin,
# e.g. http://127.0.0.1:8010. Do NOT include a trailing slash.
#
# Example:
# ROUTELENS_BACKEND_URL=http://127.0.0.1:8010

ROUTELENS_BACKEND_URL=

# ---------------------------------------------------------------------------
# The following two variables are used by the browser (E2E) test suite, not
# by the running application. Pass them on the pytest command line, e.g.:
#
#   ROUTELENS_URL=http://127.0.0.1:5173 \
#   ROUTELENS_HEALTH=http://127.0.0.1:8000/health \
#   python -m pytest tests/test_e2e_browser.py -q
#
# ROUTELENS_URL     Frontend URL the browser tests drive (default: http://127.0.0.1:5173)
# ROUTELENS_HEALTH  Backend health URL the browser tests poll (default: http://127.0.0.1:8000/health)
# ---------------------------------------------------------------------------
